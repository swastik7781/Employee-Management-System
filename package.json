{
  "name": "worksphere-pro",
  "version": "1.0.0",
  "description": "Complete Workforce Management System for Swastik Industries",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm run dev --workspace=server",
    "client:dev": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose up --build",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "employee-management",
    "hrms",
    "payroll",
    "attendance",
    "mern-stack"
  ],
  "author": "Swastik Industries",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
